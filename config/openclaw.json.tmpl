{
  "agents": {
    "defaults": {
      "model": { "primary": "${LLM_PROVIDER}/${LLM_MODEL}" },
      "timeoutSeconds": 600
    },
    "list": [
      {
        "id": "anubis",
        "default": true,
        "workspace": "/home/agent/.openclaw/workspace/anubis"
      },
      {
        "id": "horus",
        "workspace": "/home/agent/.openclaw/workspace/horus"
      },
      {
        "id": "chappie",
        "workspace": "/home/agent/.openclaw/workspace/chappie"
      }
    ]
  },
  "models": {
    "mode": "merge",
    "providers": ${LLM_PROVIDERS_JSON}
  },
  "channels": {
    "defaults": {},
    "discord": {
      "enabled": true,
      "accounts": {
        "anubis": {
          "token": "${DISCORD_TOKEN_ANUBIS}",
          "enabled": true,
          "name": "Anubis",
          "healthMonitor": { "enabled": true }
        },
        "horus": {
          "token": "${DISCORD_TOKEN_HORUS}",
          "enabled": true,
          "name": "Horus",
          "healthMonitor": { "enabled": true }
        },
        "chappie": {
          "token": "${DISCORD_TOKEN_CHAPPIE}",
          "enabled": true,
          "name": "Chappie",
          "healthMonitor": { "enabled": true }
        }
      },
      "groupPolicy": "allowlist",
      "guilds": {
        "${DISCORD_GUILD_ID}": { "requireMention": true }
      }
    }
  },
  "bindings": [
    { "agentId": "anubis", "match": { "channel": "discord", "accountId": "anubis" } },
    { "agentId": "horus",  "match": { "channel": "discord", "accountId": "horus"  } },
    { "agentId": "chappie", "match": { "channel": "discord", "accountId": "chappie" } }
  ],
  "mcp": {
    "servers": {
      "gh": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}" },
        "connectionTimeoutMs": 30000
      },
      "zernio": {
        "command": "npx",
        "args": ["-y", "mcp-remote@latest", "https://mcp.zernio.com/mcp", "--header", "Authorization: Bearer ${ZERNIO_API_KEY}"],
        "connectionTimeoutMs": 30000
      }
    },
    "sessionIdleTtlMs": 600000
  },
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_AUTH_TOKEN}"
    },
    "controlUi": {
      "allowInsecureAuth": true,
      "allowedOrigins": [
        "http://127.0.0.1:18789", "http://localhost:18789",
        "http://127.0.0.1:18790", "http://localhost:18790",
        "http://127.0.0.1:18791", "http://localhost:18791",
        "http://127.0.0.1:18792", "http://localhost:18792"
      ]
    },
    "trustedProxies": ["127.0.0.1", "::1"]
  },
  "tools": {
    "web": {
      "search": {
        "enabled": true,
        "provider": "${WEB_SEARCH_PROVIDER}",
        "apiKey": "${WEB_SEARCH_API_KEY}",
        "maxResults": 5,
        "timeoutSeconds": 30,
        "cacheTtlMinutes": 15
      },
      "fetch": {
        "enabled": true,
        "readability": true,
        "timeoutSeconds": 30,
        "maxChars": 50000
      }
    }
  },
  "browser": {
    "enabled": true,
    "headless": true,
    "noSandbox": true,
    "evaluateEnabled": true,
    "executablePath": "/usr/bin/chromium",
    "tabCleanup": {
      "enabled": true,
      "idleMinutes": 60,
      "maxTabsPerSession": 4
    }
  },
  "plugins": {
    "entries": {
      "bonjour": { "enabled": false },
      "openclaw-control-plugin": { "enabled": true }
    }
  },
  "commands": {
    "useAccessGroups": false
  },
  "update": { "checkOnStart": false },
  "meta": {
    "lastTouchedVersion": "${OPENCLAW_VERSION}",
    "lastTouchedAt": "${OPENCLAW_NOW}"
  }
}

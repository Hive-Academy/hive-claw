docs/.vitepress/cache/

# Persona privacy invariant — local-memory must never be committed.
# PRIVATE_AGENT_FILES (persona.md, secrets.md, *.json) live here and never
# traverse HTTP or git. See CLAUDE.md and docs/SECURITY.md.
local-memory/

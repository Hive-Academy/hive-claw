# Copy this file to .env and fill in the values. .env is gitignored.
# Run ./setup.sh after editing — it auto-generates the secrets that are
# safe to auto-generate (OPENCLAW_AUTH_TOKEN, OPENCLAW_JWT_SECRET,
# OPENCLAW_INTERNAL_TOKEN) and prompts for the rest.

# ============================================================================
# 1. Inference provider (gateway tier — tier 2 uses ptah-cli's own auth)
# ============================================================================
# Pick ONE of: ollama, openai, anthropic, openrouter, groq, custom.
# Fill in only the matching *_API_KEY / *_BASE_URL row below.
LLM_PROVIDER=ollama

# Model id as the chosen provider expects it.
# (ollama: "kimi-k2.6:cloud" / openai: "gpt-4o" / anthropic: "claude-sonnet-4-6" / etc.)
LLM_MODEL=kimi-k2.6:cloud

# Vision-turn override. When a persona has `chatTier.acceptAttachments: true`
# in its harness.yaml AND the operator's Discord message includes an image,
# the chat tier swaps `LLM_MODEL` for this one for that turn only. Leave empty
# to disable the swap (then LLM_MODEL must already be vision-capable).
# Recommended: qwen3-vl:235b-cloud (Ollama Cloud, Apache-2.0, trained on UI grounding).
LLM_VISION_MODEL=qwen3-vl:235b-cloud

# Per-attachment download cap and per-message attachment count. Anything larger
# is skipped with a note in the assistant's context. Defaults: 8 MB, 8 files.
# OPENCLAW_ATTACHMENT_MAX_BYTES=8388608
# OPENCLAW_ATTACHMENT_MAX_COUNT=8

OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# ============================================================================
# 2. Workspace + skills (gateway tier)
# ============================================================================
# Bot's working dir = this folder. Each subfolder = one project.
WORKSPACE_DIR=${HOME}/projects

# Global skills directory, bind-mounted into the container.
SKILLS_DIR=./skills

# ============================================================================
# 3. Ptah CLI + GitHub (shared between host and container)
# ============================================================================
# ~/.ptah is bind-mounted into the container, so a single `ptah auth login`
# (run on the host OR inside the container) authenticates both sides.
PTAH_CONFIG_DIR=${HOME}/.ptah

# Workspace name Ptah should register for this stack. Defaults to the basename
# of WORKSPACE_DIR.
PTAH_WORKSPACE_NAME=

# Where the host's `gh` CLI stores its auth. Bind-mounted into the container
# so a single `gh auth login` on the host = the agent is authenticated too.
GH_CONFIG_DIR=${HOME}/.config/gh

# How `gh` should store its OAuth token on the host:
#   file     — writes the token to ~/.config/gh/hosts.yml (container can read it)
#   keyring  — uses the OS keyring (GNOME Keyring / libsecret); container CANNOT read this
#   token    — skip OAuth entirely, just use GITHUB_TOKEN below
#   skip     — don't touch gh auth during setup.sh (handle it yourself)
GH_AUTH_MODE=file

# Optional fallback when `gh auth login` on the host isn't an option.
GITHUB_TOKEN=

# Zernio social-media API key (used by the chappie persona via MCP).
# Get your key at https://zernio.com/agents — free tier covers 2 accounts.
ZERNIO_API_KEY=

# ============================================================================
# 4. openclaw-control — core (the dashboard + REST + SSE on :7878)
# ============================================================================
# Set to 1 to skip starting the control daemon + bot bridge entirely.
# (Useful if you want to run only the legacy gateway tier.)
OPENCLAW_CONTROL_DISABLE=0

# Bind address on the host for port 7878. Default is loopback only.
# Set to 0.0.0.0 only with TLS in front (Tailscale Funnel / Caddy / Cloudflare).
OPENCLAW_CONTROL_BIND=127.0.0.1

# JWT signing secret for dashboard sessions. setup.sh auto-generates this if
# empty. Rotate to invalidate every existing session.
OPENCLAW_JWT_SECRET=

# Service token used by the bot-bridge and dispatched agents to call the daemon
# from inside the container. setup.sh auto-generates this if empty.
OPENCLAW_INTERNAL_TOKEN=

# Bot-bridge → daemon base URL. The bot-bridge runs as a sibling process inside
# the same container as the daemon, so the in-container default works for the
# stock setup. Override only if you split bot-bridge to a different host.
OPENCLAW_DAEMON_URL=http://localhost:7878

# Continuation loop tick interval (ms). Leader only. Set high to slow down dispatch.
OPENCLAW_TICK_MS=30000

# Default project slug for `!task <description>` when used without explicit project.
OPENCLAW_DEFAULT_PROJECT=

# ptah-bridge URL — when set, the daemon delegates orchestration runs to a
# host-side ptah process (scripts/ptah-bridge.mjs), so ptah uses the host's
# Claude CLI / codex / gh / desktop auth state. Leave empty to fall back to
# spawning ptah inside the container (dev/test mode only).
# Default for the production setup is host.docker.internal:8744.
OPENCLAW_PTAH_BRIDGE_URL=http://host.docker.internal:8744

# Legacy openclaw-gateway dashboard auth — bearer token gating :18789.
# setup.sh auto-fills this when empty.
OPENCLAW_AUTH_TOKEN=

# ============================================================================
# 5. Leader / follower mode
# ============================================================================
# Exactly ONE machine in your fleet should set OPENCLAW_LEADER=1. That machine
# runs the continuation loop and hosts the user-facing dashboard. All other
# machines run as followers — they only execute dispatches addressed to their
# local agents.
OPENCLAW_LEADER=0

# Comma-separated list of agent ids this machine owns. Each id must have:
#   - a memory_files row with scope=agents,id=<id>,filename=identity.md  (public bio, served by the leader's daemon)
#   - local-memory/agents/<id>/persona.md           (private system prompt, NEVER synced)
#   - DISCORD_TOKEN_<UPPER_ID> below set            (so the bot-bridge can sign in)
# Examples:
#   On the Anubis machine: OPENCLAW_LOCAL_AGENT_IDS=anubis
#   On the Amun machine:   OPENCLAW_LOCAL_AGENT_IDS=amun
# Leave empty for single-machine / dev mode (ownership checks bypassed).
OPENCLAW_LOCAL_AGENT_IDS=

# ============================================================================
# 6. Storage (leader-only) — SQLite spec store
# ============================================================================
# The leader's daemon owns a single SQLite file holding every project, task,
# dispatch, memory entry and dispatch_log row. It lives at this path INSIDE
# the container (persisted on the host via the named docker volume `specs-db`).
# Followers never open this file — they go HTTP-only via OPENCLAW_LEADER_URL.
OPENCLAW_SPECS_DB_PATH=/data/specs.db

# ----- Follower mode -----
# When OPENCLAW_LEADER=0, the daemon runs as a thin HTTP client of the leader.
# Set this to the leader's daemon base URL (no trailing slash).
# Examples:  http://leader.lan:7878  or  https://leader.tailnet.ts.net
# Required on followers; ignored on the leader.
OPENCLAW_LEADER_URL=

# ----- Dispatch tuning -----
# K consecutive failures (per project, task, phase) before a dispatch is
# poisoned and the worker refuses to claim further attempts. Default 3.
OPENCLAW_DISPATCH_FAILURE_THRESHOLD=3

# ============================================================================
# 7. Local memory — NEVER synced
# ============================================================================
# Holds private agent personas (system prompts) and per-machine secrets.
# Each agent's persona lives ONLY on the machine that owns it. Anubis's
# persona stays on the leader, Amun's stays on Amun's host. There is no
# API path that can leak a persona over the network.
OPENCLAW_LOCAL_MEMORY_DIR=${HOME}/.claude/local-memory

# ============================================================================
# 8. Discord — OAuth (dashboard login) + per-agent bot tokens (bot-bridge)
# ============================================================================
# OAuth lets you log into the dashboard from a phone or another laptop.
# When DISCORD_CLIENT_ID is empty, the daemon falls back to a "local-dev"
# user with no auth — fine for localhost-only, do NOT expose publicly.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must match the "Redirects" entry in the Discord Developer Portal exactly.
# For Tailscale Funnel: https://<host>.<tailnet>.ts.net/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:7878/auth/discord/callback

# CSV allowlist of Discord user IDs allowed to log in. Empty + public exposure
# = anyone with a Discord account can hit the dashboard. Lock this down.
DISCORD_ALLOWED_USER_IDS=

# Optional guild-membership check (used only if DISCORD_ALLOWED_USER_IDS is empty).
DISCORD_ALLOWED_GUILD_ID=

# Per-agent bot tokens. One env var per agent dir. Default name is
# DISCORD_TOKEN_<UPPER_ID>; override via the memory_files entry
# scope=agents,id=<id>,filename=discord.json (key tokenEnvVar).
#
# Post-TASK_2026_006 Batch 6, the openclaw gateway template
# (config/openclaw.json.tmpl) wires the default personas directly:
#   - DISCORD_TOKEN_ANUBIS → channels.discord.accounts.anubis.token
#   - DISCORD_TOKEN_HORUS  → channels.discord.accounts.horus.token
#   - DISCORD_TOKEN_CHAPPIE → channels.discord.accounts.chappie.token
# Empty tokens leave that persona's bot disconnected (config still renders);
# the bound persona on this machine (per OPENCLAW_LOCAL_AGENT_IDS) must have
# its token set for that persona to come online.
DISCORD_TOKEN_ANUBIS=
DISCORD_TOKEN_HORUS=
DISCORD_TOKEN_CHAPPIE=
# Additional personas (set when adding agents.list[] entries in openclaw.json.tmpl):
# DISCORD_TOKEN_AMUN=

# ----- Legacy: gateway-tier discord adapter -----
# DEPRECATED: DISCORD_BOT_TOKEN is the pre-Batch-6 single-bot token. Removal
# lands in TASK_2026_006 Batch 11; until then, entrypoint.sh keeps it in the
# envsubst variable list for transitional compatibility. New deployments
# should leave it empty and use the per-persona DISCORD_TOKEN_* tokens above.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ============================================================================
# 9. Tailscale (optional — only if the leader exposes its dashboard publicly)
# ============================================================================
# Setup is interactive (`tailscale funnel --bg --https=443 7878`) and not
# scripted by setup.sh. See docs/OPENCLAW_CONTROL.md for the recipe.
# No env vars to set here; this section is a marker for the operator.

# ============================================================================
# 10. Docker Hub (optional)
# ============================================================================
# Used by ./scripts/dc.sh, a `docker` wrapper that bypasses your global
# credsStore (useful when gnome-keyring is locked and `docker pull` times out).
# Token from https://hub.docker.com/settings/security (Public Repo Read-only is enough).
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# ============================================================================
# 11. TASK_2026_002 — chat-tier tool-calling + harness runtime
# ============================================================================
# Tool-calling chat (chat tier feature flag — Phase 1).
# Default OFF; flip on after a per-persona harness is in shared memory.
# Rollback: set to 0 and restart bot-bridge — chat falls through to chatComplete.
OPENCLAW_BOT_TOOL_CALLS_ENABLED=0

# Tool-calling loop bounds.
OPENCLAW_TOOL_CALL_DEPTH_LIMIT=8        # max rounds in chatCompleteWithTools
OPENCLAW_SUBAGENT_DEPTH_LIMIT=2         # max recursion in subagentRunner
OPENCLAW_MCP_DEFAULT_TIMEOUT_MS=30000   # per-tool-call timeout for MCP servers
OPENCLAW_MCP_MAX_CONCURRENT_SERVERS=8   # per-host MCP process budget

# Harness-authoring chat timeout (auto-cancel idle sessions).
OPENCLAW_HARNESS_AUTHOR_TIMEOUT_MS=1800000   # 30 min

# Community-tier-only assertion (CI / paranoid operator).
# When 1, daemon refuses to boot if `ptah license status` reports !== 'community'.
OPENCLAW_REQUIRE_COMMUNITY_TIER=0

# Skills root (where SKILL.md files live; persona's harness references by name).
OPENCLAW_SKILLS_ROOT=/home/agent/skills

# Where the bridge expects ptah's home dir on the HOST.
# materialize.ts emits paths under this prefix.
OPENCLAW_HOST_HOME=/home/anubis

# ptah min version (validated at daemon boot; below this, ptahLauncher uses 0.1.3 branch).
PTAH_MIN_VERSION=0.1.5

# TASK_2026_006 Batch 10 follow-up: docker.sock group for the daemon
# container. The daemon needs read/write access to /var/run/docker.sock
# to drive the plugin/MCP install pipeline (Batch 8b). Set this to the
# numeric GID of the host's docker group (run `stat -c '%g'
# /var/run/docker.sock` to find it). Common values: 985 (Debian/Ubuntu
# with system docker), 999 (some distros), 0 (rootful in container).
DOCKER_GID=985

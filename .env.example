# Copy this file to .env and fill in the values. .env is gitignored.
# setup.sh will auto-generate OPENCLAW_AUTH_TOKEN if it is empty.

# --- OpenClaw dashboard auth (any non-empty random hex; setup.sh fills it in) ---
OPENCLAW_AUTH_TOKEN=

# --- Inference provider ----------------------------------------------------
# Pick ONE. Fill in only the matching *_API_KEY / *_BASE_URL below.
#   ollama     — local or Ollama Cloud, OpenAI-compat API
#   openai     — OpenAI direct (api.openai.com)
#   anthropic  — Anthropic direct (api.anthropic.com)
#   openrouter — OpenRouter aggregator (openrouter.ai)
#   groq       — Groq (api.groq.com, OpenAI-compat)
#   custom     — any OpenAI-compat endpoint (set CUSTOM_BASE_URL + CUSTOM_API_KEY)
LLM_PROVIDER=ollama

# Model id as the chosen provider expects it
# (ollama: "kimi-k2.6:cloud" / openai: "gpt-4o" / anthropic: "claude-sonnet-4-6" / etc.)
LLM_MODEL=kimi-k2.6:cloud

# Provider-specific. Only the row matching LLM_PROVIDER needs to be set.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# --- Shared workspace (where bot and you collaborate) ---
# Bot's working dir = this folder. Each subfolder = one project.
WORKSPACE_DIR=${HOME}/projects

# --- Global skills directory (shared across projects) ---
SKILLS_DIR=./skills

# --- Discord channel (optional — leave both empty to disable) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- Ptah CLI integration (project orchestration / GitHub auth) ------------
# ~/.ptah is bind-mounted into the container, so a single `ptah auth login`
# (run on the host OR inside the container) authenticates both sides.
PTAH_CONFIG_DIR=${HOME}/.ptah

# Optional: a GitHub personal-access token. Only needed as a fallback when
# `gh auth login` on the host isn't an option (the container otherwise inherits
# your host's gh auth via the ${GH_CONFIG_DIR} bind mount — see docker-compose.yml).
GITHUB_TOKEN=

# Where the host's `gh` CLI stores its auth. Bind-mounted into the container so
# `gh auth login` on the host = the agent is authenticated too.
GH_CONFIG_DIR=${HOME}/.config/gh

# How `gh` should store its OAuth token on the host:
#   file     — writes the token to ~/.config/gh/hosts.yml (the container can read it)
#   keyring  — uses the OS keyring (GNOME Keyring / libsecret); container CANNOT read this
#   token    — skip OAuth entirely, just use GITHUB_TOKEN above
#   skip     — don't touch gh auth during setup.sh (you'll handle it yourself)
# Default 'file' is what makes the bind mount actually work. Override only if you
# already manage gh auth via your distro's keyring and have a different plan.
GH_AUTH_MODE=file

# Workspace name Ptah should register for this stack. Defaults to the
# basename of WORKSPACE_DIR.
PTAH_WORKSPACE_NAME=

# --- openclaw-control: dashboard + multi-agent bot bridge ------------------
# Runs in the same container as openclaw, exposed on :7878 (host-bound 127.0.0.1
# by default). All bots registered under shared-memory/agents/ get the same
# memory tree, the same continuation loop, the same Discord OAuth.

# --- Shared-specs git repo (the global task tree) ---
# Every machine clones this repo and keeps it synced. ptah CLI on each machine
# writes into specs/<project>/ locally; the daemon commits + pushes for you.
# Use a private repo. HTTPS + PAT is the simplest auth path.
OPENCLAW_SPECS_REPO_URL=
OPENCLAW_SPECS_BRANCH=main
OPENCLAW_GIT_TOKEN=                          # GitHub PAT with repo scope
OPENCLAW_GIT_USER_NAME=openclaw-control
OPENCLAW_GIT_USER_EMAIL=openclaw@localhost
OPENCLAW_GIT_PULL_MS=15000

# Where the synced clone lives on the host. Bind-mounted into the container
# at /home/agent/.claude/shared-specs.
OPENCLAW_SHARED_SPECS_DIR=${HOME}/.claude/shared-specs

# --- Local (per-machine) memory — NEVER synced to git ---
# Holds private agent personas (system prompts) and per-machine secrets.
# Each agent's persona lives ONLY on the machine that owns the agent —
# Anubis's persona stays on the leader, Amun's stays on Amun's host.
OPENCLAW_LOCAL_MEMORY_DIR=${HOME}/.claude/local-memory

# --- Leader / follower mode ---
# Exactly ONE machine should set OPENCLAW_LEADER=1 — that machine runs the
# continuation loop, hosts the user-facing dashboard, and writes new dispatches.
# All other machines run as followers: they only pick up dispatches assigned to
# their local agents.
OPENCLAW_LEADER=0

# Comma-separated agent ids this machine is allowed to execute (matches the
# agents/<id>/ folders + this machine's DISCORD_TOKEN_<ID> env vars).
# Example on the Anubis machine: OPENCLAW_LOCAL_AGENT_IDS=anubis
# Example on the Amun machine:   OPENCLAW_LOCAL_AGENT_IDS=amun
OPENCLAW_LOCAL_AGENT_IDS=

# Bind address on the host for port 7878. Default is loopback only.
# Set to 0.0.0.0 to expose on the LAN — only do this with TLS in front
# (Caddy / Tailscale / your reverse proxy of choice).
OPENCLAW_CONTROL_BIND=127.0.0.1

# Set to 1 to skip starting the control daemon + bot bridge in the container.
OPENCLAW_CONTROL_DISABLE=0

# JWT signing secret for dashboard sessions. CHANGE THIS to a long random string.
OPENCLAW_JWT_SECRET=change-me-to-a-long-random-string-please

# Discord OAuth — required to log in from a different device than the host.
# When unset, the daemon falls back to a local-dev user with no auth (loopback only).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:7878/auth/discord/callback
# Comma-separated list of Discord user IDs allowed to log in. Empty = anyone with
# Discord can log in. Lock this down to your own ID for personal setups.
DISCORD_ALLOWED_USER_IDS=

# Per-agent Discord bot tokens. One env var per agent dir under
# shared-memory/agents/<id>/. Default name is DISCORD_TOKEN_<UPPER_ID>; override
# via shared-memory/agents/<id>/discord.json#tokenEnvVar.
# Examples:
# DISCORD_TOKEN_ANUBIS=
# DISCORD_TOKEN_CHAPPIE=

# Default project slug for `!task <description>` when used without an explicit project.
OPENCLAW_DEFAULT_PROJECT=

# Continuation loop tick interval (ms). Set high to slow down dispatch.
OPENCLAW_TICK_MS=30000

# --- Docker Hub auth (optional) ---
# Used by ./scripts/dc.sh, a `docker` wrapper that bypasses your global
# credsStore (useful when gnome-keyring is locked and `docker pull` times out).
# Token from https://hub.docker.com/settings/security (Public Repo Read-only is enough).
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
